---
/**
 * الشعار الكامل: الرمز + كلمة MARCODEA وتحتها BUILD بخطين سماويين.
 * variant="light" للاستعمال على خلفية داكنة، و"dark" على خلفية فاتحة.
 */
import Logomark from './Logomark.astro';
import { brand } from '../data/content';

interface Props {
  variant?: 'light' | 'dark';
  href?: string;
  ariaLabel?: string;
}

const { variant = 'light', href, ariaLabel } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', variant === 'dark' && 'on-light']} href={href}>
  <Logomark />
  <span class="wm">
    <b>{brand.nameEn}</b>
    <i>{brand.nameEnSub}</i>
  </span>
  {href && <span class="sr-only">{ariaLabel ?? brand.homeLabel}</span>}
</Tag>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo :global(svg) {
    width: 46px;
    height: auto;
    flex: none;
  }

  .wm {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .wm b {
    font-family: var(--f-en);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.01em;
    color: var(--white);
  }

  .wm i {
    font-style: normal;
    font-family: var(--f-en);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.55em;
    color: var(--white);
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline-start: 0.55em;
  }

  .wm i::before,
  .wm i::after {
    content: '';
    height: 1px;
    flex: 1;
    background: var(--cyan);
    opacity: 0.8;
  }

  .on-light .wm b,
  .on-light .wm i {
    color: var(--navy);
  }

  @media (max-width: 560px) {
    .wm b {
      font-size: 17px;
    }
  }
</style>
