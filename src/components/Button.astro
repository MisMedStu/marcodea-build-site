---
/**
 * زر موحّد. يُخرج <a> إذا مُرِّر href، و<button> حقيقيًا إن لم يُمرَّر.
 */
interface Props {
  variant?: 'primary' | 'ghost' | 'dark' | 'wa';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  block?: boolean;
  ariaLabel?: string;
  id?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className,
  block = false,
  ariaLabel,
  id,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, block && 'btn-block', className]}
  href={href}
  type={href ? undefined : type}
  aria-label={ariaLabel}
  id={id}
>
  <slot />
</Tag>

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding-inline: 24px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
    white-space: nowrap;
  }

  .btn svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .btn-block {
    width: 100%;
  }

  .btn-primary {
    background: var(--blue);
    color: var(--white);
  }

  .btn-primary:hover {
    background: var(--color-blue-hover);
    transform: translateY(-1px);
  }

  .btn-ghost {
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--white);
    background: transparent;
  }

  .btn-ghost:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .btn-dark {
    background: var(--navy);
    color: var(--white);
  }

  .btn-dark:hover {
    background: var(--navy-deep);
  }

  .btn-wa {
    background: var(--color-wa);
    color: var(--white);
  }

  .btn-wa:hover {
    background: var(--color-wa-hover);
  }
</style>
