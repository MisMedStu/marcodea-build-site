---
/**
 * بيانات منظَّمة لمحركات البحث (schema.org).
 * لا يُضاف هنا أي رقم أو ادعاء غير موجود في محتوى الموقع:
 * لا تقييمات ولا عدد مشاريع ولا نطاق أسعار.
 */
import { site, seo, PHONE_TEL, social } from '../data/site';
import { brand, footer, services } from '../data/content';
import { absoluteUrl } from '../lib/url';

const activeSocial = social.filter((item) => item.url !== '').map((item) => item.url);

const schema = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'LocalBusiness'],
  '@id': `${absoluteUrl('/', Astro.site, site.url)}#business`,
  name: brand.nameAr,
  alternateName: `${brand.nameEn} ${brand.nameEnSub}`,
  description: footer.about,
  url: absoluteUrl('/', Astro.site, site.url),
  image: absoluteUrl(seo.ogImage, Astro.site, site.url),
  logo: absoluteUrl('favicon.svg', Astro.site, site.url),
  telephone: PHONE_TEL,
  email: site.email,
  foundingDate: site.founded,
  slogan: brand.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressCountry: site.address.countryCode,
  },
  areaServed: site.areaServed.map((area) => ({ '@type': 'Place', name: area })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: services.title,
    itemListElement: services.items.map((item) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: item.title,
        description: item.text,
      },
    })),
  },
  ...(activeSocial.length > 0 ? { sameAs: activeSocial } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
